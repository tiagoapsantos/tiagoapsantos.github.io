---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects, projectHref } from '../../data/projects';
const projects = await getProjects('pt');
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout locale="pt" active="projects" title="Projetos" description="Projetos de desenvolvimento Web e aplicações pessoais, com estudos de caso e código.">
  <section class="container page-heading projects-heading"><p class="eyebrow">Projetos</p><h1>Projetos e estudos de caso</h1><p class="page-intro">Websites, plataformas e aplicações. Cada estudo de caso apresenta a implementação, a autoria e os limites do projeto.</p></section>
  <section class="container projects-section" aria-label="Lista de projetos"><div class="project-grid project-grid-wide">{projects.map((project, index) => <article class:list={['project-card', 'project-card-rich', project.images?.length ? 'project-card-featured' : 'project-card-concept']}>
    <div class="project-card-copy"><span class="project-index">{String(index + 1).padStart(2, '0')}</span><span class="project-kind">{project.kind}</span><h2>{project.title}</h2><p>{project.description}</p><div class="tag-list">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div>{project.caseStudy && <a class="text-link case-study-link" aria-label={`Ver estudo de caso: ${project.title}`} href={projectHref('pt', project.slug)}>Ver estudo de caso <span aria-hidden="true">→</span></a>}</div>
    {project.images?.length && <div class="project-gallery project-gallery-stack">{project.images.slice(0, project.video ? 1 : 2).map((image) => <a class="project-image-link" href={`${base}${image.src.replace(/^\/+/, '')}`} target="_blank" rel="noreferrer" aria-label={`Abrir imagem: ${image.alt}`}><img src={`${base}images/projects/galeria/${image.src.replace(/^\/images\/projects\//, '').replace(/\.(webp|jpe?g|png)$/i, '').replace(/\//g, '-')}-1100.webp`} srcset={`${base}images/projects/galeria/${image.src.replace(/^\/images\/projects\//, '').replace(/\.(webp|jpe?g|png)$/i, '').replace(/\//g, '-')}-640.webp 640w, ${base}images/projects/galeria/${image.src.replace(/^\/images\/projects\//, '').replace(/\.(webp|jpe?g|png)$/i, '').replace(/\//g, '-')}-1100.webp 1100w`} sizes="(max-width: 700px) calc(100vw - 72px), 560px" alt={image.alt} width="1100" height="698" loading="lazy" decoding="async" /></a>)}{project.video && <div class="project-video-box"><video class="project-video" src={`${base}${project.video.src.replace(/^\/+/, '')}`} poster={project.video.poster ? `${base}${project.video.poster.replace(/^\/+/, '')}` : undefined} width={project.video.width} height={project.video.height} muted loop playsinline controls preload="none" data-auto aria-label={project.video.title} title={project.video.title}>Demonstração em vídeo</video></div>}</div>}
  </article>)}</div></section>
<script is:inline>(() => { if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return; const o = new IntersectionObserver((es) => es.forEach((e) => { const v = e.target; if (e.isIntersecting) v.play().catch(() => {}); else v.pause(); }), { threshold: 0.5 }); document.querySelectorAll('video[data-auto]').forEach((v) => o.observe(v)); })();</script>
</BaseLayout>
